# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# Use o MESMO projeto em .env.local, Vercel e URL Configuration do Supabase.
# Supabase (projeto MedScript)
NEXT_PUBLIC_SUPABASE_URL=https://katepfoxlainldspmbfk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave service_role (Settings > API) — necessária para criar sub-usuários
# NUNCA exponha esta chave no frontend
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Produção (Vercel): NEXT_PUBLIC_SITE_URL=https://www.medscript.com.br
# Opcional — Google Search Console (grátis): tag HTML de verificação
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=cole-aqui-o-codigo-do-search-console

# Primeiro admin do site (SQL no Supabase):
# UPDATE public.profiles SET platform_role = 'super_admin' WHERE email = 'seu-email@dominio.com';

# Pagamentos: false = todo mundo usa o app sem cobrança (trial continua sendo registrado no banco).
# Quando for cobrar, defina true e faça redeploy.
BILLING_PAYMENTS_ENABLED=false

# Mercado Pago — Assinaturas + Checkout Pro (pagamento único Pix/boleto)
# Aplicação "Assinaturas" para renovação no cartão; o mesmo token serve ao Checkout Pro.
MERCADOPAGO_ACCESS_TOKEN=
# Opcional — só se quiser "plano associado" no painel MP (senão a API manda valor/periodicidade):
# MERCADOPAGO_PREAPPROVAL_PLAN_MONTHLY=
# MERCADOPAGO_PREAPPROVAL_PLAN_ANNUAL=
# (gerar com: node scripts/create-mp-subscription-plans.mjs)
# Segredo do webhook (Suas integrações > Webhooks). Recomendado em produção.
# MERCADOPAGO_WEBHOOK_SECRET=
# URL do webhook: {NEXT_PUBLIC_SITE_URL}/api/payments/mercadopago/webhook
# Marque: Pagamentos + Planos e assinaturas (+ Pedidos comerciais, opcional)
